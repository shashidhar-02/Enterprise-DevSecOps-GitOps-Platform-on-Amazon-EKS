{
  "name": "cravedrop-backend",
  "version": "1.0.0",
  "description": "CraveDrop Food Delivery Platform - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint . --max-warnings 0",
    "seed": "node seed.js",
    "admin": "node scripts/admin.js",
    "test": "node --test test/*.test.js",
